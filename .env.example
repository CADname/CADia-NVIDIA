# CADia NVIDIA Hackathon Edition
POSTGRES_DB=cadia_hackathon
POSTGRES_USER=cadia_hackathon
POSTGRES_PASSWORD=CHANGE_ME_WITH_OPENSSL_RAND_HEX_32
NEXIS_SESSION_SECRET=CHANGE_ME_WITH_OPENSSL_RAND_BASE64_48

# First IP-only boot uses HTTP. After DNS/HTTPS, deploy/enable-hackathon-domain.sh sets production values.
NEXIS_COOKIE_SECURE=false
NEXIS_CORS_ORIGINS=http://127.0.0.1
NEXIS_ALLOWED_HOSTS=127.0.0.1,localhost
NEXIS_AI_PROVIDER=app_server

# Codex App Server
CODEX_CLI_VERSION=0.154.0
CODEX_PROCESS_IDLE_SECONDS=1800
NEXIS_MAX_CODEX_PROCESSES=8
NEXIS_MAX_CONCURRENT_AI_TURNS=2
CADIA_HEAVY_CAD_WORKERS=2
CADIA_HEAVY_QUEUE_TIMEOUT_SECONDS=7200
CADIA_HEAVY_CANCEL_GRACE_SECONDS=8
CAD_ENGINE_IDLE_SECONDS=1800
NEXIS_MAX_UPLOAD_BYTES=104857600
NEXIS_MESH_TOLERANCE=0.08
NEXIS_EDGE_TOLERANCE=0.12
NEXIS_PREFERRED_MODELS=

# Optional server OpenAI / CADia AI
OPENAI_API_KEY=
OPENAI_API_MODEL=gpt-6.1-sol
OPENAI_API_BASE=https://api.openai.com/v1
CADIA_SHARED_OPENAI_ENABLED=true
CADIA_SHARED_OPENAI_MAX_CALLS_GLOBAL_DAY=150
CADIA_SHARED_OPENAI_MAX_OUTPUT_TOKENS=10000

# NVIDIA Nemotron via Nebius Token Factory. Never commit the real key.
NEBIUS_API_KEY=
NEBIUS_TOKEN_FACTORY_BASE_URL=https://api.tokenfactory.us-central1.nebius.com/v1
NEBIUS_NEMOTRON_MODEL=nvidia/Nemotron-3-Ultra-550b-a55b
CADIA_NEMOTRON_ENABLED=true
CADIA_NEMOTRON_TIMEOUT_SECONDS=90
CADIA_NEMOTRON_POST_VERIFY_ENABLED=true
CADIA_NEMOTRON_POST_VERIFY_AUTO_REPAIR=true
CADIA_NEMOTRON_VERIFY_MIN_CONFIDENCE=0.97
CADIA_NEMOTRON_HYBRID_MODE=balanced

# NVIDIA Engineering Review. Nemotron hybrid above can run without Cosmos.
CADIA_NVIDIA_REVIEW_ENABLED=false
CADIA_NVIDIA_AUTO_REPAIR=true
CADIA_NVIDIA_COSMOS_BASE_URL=
CADIA_NVIDIA_COSMOS_API_KEY=
CADIA_NVIDIA_COSMOS_MODEL=nvidia/cosmos3-nano-reasoner
CADIA_NVIDIA_REVIEW_TIMEOUT_SECONDS=180
CADIA_NVIDIA_RENDER_TIMEOUT_SECONDS=45
CADIA_NVIDIA_REVIEW_MIN_CONFIDENCE=0.62
CADIA_NVIDIA_VISUAL_REGRESSION_TOLERANCE=0.04
CADIA_NVIDIA_MAX_SOURCE_IMAGES=4
CADIA_NVIDIA_MAX_MEDIA_BYTES=33554432

# Hackathon judge login — set real values only in server .env, never in Git.
CADIA_HACKATHON_USERNAME=judge
CADIA_HACKATHON_PASSWORD=CHANGE_ME
CADIA_HACKATHON_USER_EMAIL=judge@cadia.local
CADIA_HACKATHON_LOCKDOWN=true

# Supplier Finder / global manufacturing directory
CADIA_TOMTOM_API_KEY=
CADIA_GEOAPIFY_API_KEY=

# Slant 3D quote/shipping integration. Demo mode blocks checkout/payment.
CADIA_SLANT3D_ENABLED=true
CADIA_SLANT3D_DEMO_MODE=true
CADIA_SLANT3D_MCP_URL=https://www.slant3d.com/mcp
CADIA_SLANT3D_TIMEOUT_SECONDS=45
CADIA_SLANT3D_MAX_STL_BYTES=20971520

# Optional CADia Studio manual fulfillment admin list
CADIA_STUDIO_ADMIN_EMAILS=

# OAuth callbacks
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://app.cadia.co.kr/api/auth/google/callback
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=https://app.cadia.co.kr/api/ai/copilot/callback
CADIA_AI_AUTO_FALLBACK=true

# OpenCV 5 assist
CADIA_OPENCV_REQUIRE_MAJOR5=true
CADIA_OPENCV_MAX_REPAIRS=2
CADIA_OPENCV_DRAWING_THRESHOLD=0.78
CADIA_OPENCV_PHOTO_THRESHOLD=0.66
CADIA_OPENCV_MAX_EDGE=2200
